        {
          "name": "Upload Video",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/videos/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "videos", "upload"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "My Awesome Video",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "This is a great video about something",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Education",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "education,tutorial,learning",
                  "type": "text"
                },
                {
                  "key": "video",
                  "type": "file"
                },
                {
                  "key": "thumbnail",
                  "type": "file"
                }
              ]
            }
          },
          "response": [
            {
              "name": "Success 201",
              "status": "Created",
              "code": 201
            },
            {
              "name": "Error 400",
              "status": "Bad Request",
              "code": 400
            }
          ]
        },
        {
