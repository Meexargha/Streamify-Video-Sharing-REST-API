{
  "info": {
    "_postman_id": "streamify-video-api",
    "name": "Streamify Video API",
    "description": "Postman collection for Streamify video sharing REST API",
    "version": "1.0.0",
    "postman": "3.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/postman_collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "signup"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "email",
                  "value": "user@test.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "password"
                },
                {
                  "key": "channelName",
                  "value": "Test Channel",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "1234567890",
                  "type": "text"
                },
                {
                  "key": "logoUrl",
                  "type": "file"
                }
              ]
            }
          },
          "response": [
            {
              "name": "Success 201",
              "status": "Created",
              "code": 201
            },
            {
              "name": "Error 500",
              "status": "Internal Server Error",
              "code": 500
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "email",
                  "value": "user@test.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "password"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "login"]
            }
          },
          "response": [
            {
              "name": "Success 200",
              "status": "OK",
              "code": 200
            },
            {
              "name": "Error 404",
              "status": "Not Found",
              "code": 404
            },
            {
              "name": "Error 401",
              "status": "Unauthorized",
              "code": 401
            }
          ]
        }
      ]
    },
