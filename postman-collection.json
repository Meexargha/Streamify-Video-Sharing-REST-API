            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/subscribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "subscribe"]
            }
          },
          "response": [
            {
              "name": "Success 200",
              "status": "OK",
              "code": 200
            },
            {
              "name": "Error 400",
              "status": "Bad Request",
              "code": 400
            }
          ]
        }
      ]
