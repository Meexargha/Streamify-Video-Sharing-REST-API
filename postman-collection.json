                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Updated description",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Updated Category",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "updated,tag1,tag2",
                  "type": "text"
                },
                {
                  "key": "thumbnail",
                  "type": "file"
                }
              ]
            }
