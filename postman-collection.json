                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "0987654321",
                  "type": "text"
                },
                {
                  "key": "logo",
                  "type": "file"
                }
              ]
            }
          },
          "response": [
            {
              "name": "Success 200",
              "status": "OK",
              "code": 200
            },
            {
              "name": "Error 500",
              "status": "Internal Server Error",
              "code": 500
            }
          ]
        },
